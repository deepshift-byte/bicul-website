---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import OppCard from "../../components/OppCard.astro";
import NewsCard from "../../components/NewsCard.astro";
import { langParams, langOf, t, data, href, DATA, sectorLabel, sectorSlug } from "../../lib/site.js";

export const getStaticPaths = langParams;
const lang = langOf(Astro.params.lang);
const u = t(lang);
const d = data(lang);
const H = d.home;
const opps = d.opportunities.map((o, i) => ({ o, sectors: DATA.en.opportunities[i].categories }));
// home shows a curated mix: opportunities with photographs first
const featured = [...opps].sort((a, b) => (b.o.image ? 1 : 0) - (a.o.image ? 1 : 0)).slice(0, 6);
const sectorKeys = DATA.en.home.frontiers_tabs.slice(1);
const divIcons = { "strategic-partnerships": "handshake", "monitoring-evaluation": "eye", statistics: "chart", incubation: "seed" };
const order = ["strategic-partnerships", "monitoring-evaluation", "statistics", "incubation"];
const divs = order.map((s) => d.divisions.find((x) => x.slug === s));
const tripleIcons = ["heritage", "people", "leaf"];
---
<Base lang={lang} path="/">
  <section class="hero" aria-labelledby="hero-title">
    <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster="/media/bulange-twekobe.webp" aria-hidden="true">
      <source src="/media/bulange-twekobe.mp4" type="video/mp4" />
    </video>
    <div class="hero__shade"></div>
    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1 id="hero-title">{H.hero_title}</h1>
        <p>{H.hero_text}</p>
        <div class="hero__ctas">
          <a class="btn btn--gold" href={href(lang, "/invest/opportunities")}>{H.hero_buttons[0]}</a>
          <a class="btn btn--ghost" href={href(lang, "/contact")}>{H.hero_buttons[1]}</a>
        </div>
      </div>
      <div class="hero__caption">
        <button class="hero__toggle" type="button" data-video-toggle aria-label={u.pauseVideo} data-play={u.playVideo} data-pause={u.pauseVideo}>
          <span data-icon-pause><Icon name="pause" size={14} /></span><span data-icon-play hidden><Icon name="play" size={14} /></span>
        </button>
        <span>{u.heroCaption}</span>
      </div>
    </div>
  </section>

  <section class="stats" aria-label={d.home.who_title}>
    <div class="wrap">
      <ul class="stats__list">
        {d.stats.map((s) => <li><span class="stats__num">{s.value.replace(/\s+/g, "")}</span><span class="stats__label">{s.label}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section who">
    <div class="wrap who__grid">
      <figure class="who__kabaka">
        <img src={H.hero_kabaka.src} width={H.hero_kabaka.w} height={H.hero_kabaka.h} alt={H.hero_kabaka_alt} loading="lazy" />
        <figcaption>{H.hero_kabaka_alt}</figcaption>
      </figure>
      <div>
        <h2>{H.who_title}</h2>
        <p class="lead">{H.who_text}</p>
        <ul class="who__divs">
          {divs.map((dv) => (
            <li>
              <a href={href(lang, `/our-work/${dv.slug}`)}>
                <span class="who__icon"><Icon name={divIcons[dv.slug]} size={22} /></span>
                <span><strong>{dv.short}</strong><span>{dv.summary}</span></span>
              </a>
            </li>
          ))}
        </ul>
        <a class="link-arrow" href={href(lang, "/about")}>{u.about}: {u.whoWeAre} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>

  <section class="section section--stone" id="opportunities">
    <div class="wrap">
      <div class="head-row">
        <div>
          <h2>{H.frontiers_title}</h2>
          <p class="lead">{H.frontiers_text}</p>
        </div>
        <a class="btn btn--line" href={href(lang, "/invest/opportunities")}>{u.viewAllOpportunities} ({d.opportunities.length})</a>
      </div>
      <ul class="sector-links">
        {sectorKeys.map((s) => <li><a href={href(lang, `/invest/opportunities?sector=${sectorSlug(s)}`)}>{sectorLabel(lang, s)}<span>{opps.filter((x) => x.sectors.includes(s)).length}</span></a></li>)}
      </ul>
      <div class="grid grid--3">
        {featured.map(({ o, sectors }) => <OppCard lang={lang} o={o} sectors={sectors} />)}
      </div>
    </div>
  </section>

  <section class="section section--night triple">
    <div class="wrap">
      <h2>{H.triple.title}</h2>
      <p class="lead">{H.triple.intro}</p>
      <ol class="triple__list">
        {H.triple.items.map((it, i) => (
          <li>
            <Icon name={tripleIcons[i]} size={30} />
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <div>
          <h2>{H.arms_title}</h2>
          <p class="lead">{H.arms_text}</p>
        </div>
        <a class="btn btn--line" href={href(lang, "/partnerships/subsidiaries")}>{u.subsidiaries} ({d.subsidiaries.length})</a>
      </div>
      <ul class="arms">
        {d.subsidiaries.map((s) => (
          <li><a href={href(lang, `/partnerships/subsidiaries/${s.slug}`)} title={s.name}>
            {s.logo ? <img src={s.logo.src} width={s.logo.w} height={s.logo.h} alt={s.name} loading="lazy" /> : <span>{s.name}</span>}
          </a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap">
      <div class="head-row">
        <div>
          <h2>{H.news_title}</h2>
          <p class="lead">{H.news_text}</p>
        </div>
        <a class="btn btn--line" href={href(lang, "/news")}>{u.allNews}</a>
      </div>
      <div class="grid grid--3">
        {d.news.slice(0, 3).map((n) => <NewsCard lang={lang} n={n} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row">
        <div>
          <h2>{H.build_title}</h2>
          <p class="lead">{H.build_text}</p>
        </div>
        <a class="btn btn--line" href={href(lang, "/partnerships/partners")}>{u.partnersCount(d.partners.length)}</a>
      </div>
      <ul class="partner-wall">
        {d.partners.map((p) => <li title={p.name}><img src={p.logo.src} width={p.logo.w} height={p.logo.h} alt={p.name} loading="lazy" /></li>)}
      </ul>
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta__inner">
      <div>
        <h2>{H.cta_title}</h2>
        <p>{H.cta_text}</p>
      </div>
      <div class="cta__actions">
        <a class="btn btn--gold" href={href(lang, "/contact")}>{H.cta_buttons[0]}</a>
        <a class="btn btn--ghost" href={href(lang, "/invest")}>{u.whyInvest}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const v = document.querySelector(".hero__video");
  const b = document.querySelector("[data-video-toggle]");
  if (v && b) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const set = (playing) => {
      b.setAttribute("aria-label", playing ? b.dataset.pause : b.dataset.play);
      b.querySelector("[data-icon-pause]").hidden = !playing;
      b.querySelector("[data-icon-play]").hidden = playing;
    };
    if (reduce.matches) { v.pause(); v.removeAttribute("autoplay"); set(false); }
    b.addEventListener("click", () => { if (v.paused) { v.play(); set(true); } else { v.pause(); set(false); } });
  }
</script>

<style>
  .hero { position: relative; min-height: min(88vh, 760px); display: flex; align-items: flex-end; color: #fff; overflow: hidden; background: var(--night); }
  .hero__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,26,69,.15) 0%, rgba(15,26,69,.35) 45%, rgba(15,26,69,.92) 100%), linear-gradient(90deg, rgba(15,26,69,.55), rgba(15,26,69,0) 70%); }
  .hero__inner { position: relative; padding-block: 120px 40px; display: grid; gap: 28px; }
  .hero__text { max-width: 780px; }
  .hero h1 { color: #fff; font-size: clamp(2.4rem, 6vw, 4.6rem); line-height: 1.04; margin-bottom: .35em; text-wrap: balance; }
  .hero__text p { font-size: clamp(1.05rem, 1.7vw, 1.3rem); color: #e3e7f6; max-width: 58ch; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .hero__caption { display: flex; align-items: center; gap: 10px; font-size: .85rem; color: #c9d0ea; border-top: 1px solid rgba(255,255,255,.18); padding-top: 14px; }
  .hero__toggle { width: 32px; height: 32px; border-radius: 50%; border: 1px solid rgba(255,255,255,.4); background: transparent; color: #fff; display: grid; place-items: center; cursor: pointer; }
  .hero__toggle:hover { background: rgba(255,255,255,.12); }

  .stats { border-bottom: 1px solid var(--line); }
  .stats__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); }
  .stats__list li { padding: 30px 24px; border-left: 1px solid var(--line); display: grid; gap: 4px; }
  .stats__list li:first-child { border-left: 0; padding-left: 0; }
  .stats__num { font-family: var(--display); font-size: clamp(2.2rem, 4vw, 3.2rem); line-height: 1; color: var(--lion); }
  .stats__label { color: var(--muted); font-size: .98rem; }
  @media (max-width: 720px) {
    .stats__list { grid-template-columns: 1fr 1fr; }
    .stats__list li { padding: 22px 0 22px 16px; border-left: 0; border-top: 1px solid var(--line); }
    .stats__list li:nth-child(odd) { padding-left: 0; }
    .stats__list li:nth-child(-n+2) { border-top: 0; }
  }

  .who__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.3fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  @media (max-width: 860px) { .who__grid { grid-template-columns: 1fr; } }
  .who__kabaka { margin: 0; background: radial-gradient(circle at 50% 62%, var(--gold-soft) 0 44%, var(--mist) 44.5% 100%); border-radius: var(--radius-l); padding: 28px 24px 0; position: relative; }
  .who__kabaka img { margin-inline: auto; max-height: 520px; width: auto; }
  .who__kabaka figcaption { position: absolute; left: 16px; bottom: 14px; background: rgba(255,255,255,.92); border-radius: 999px; padding: 6px 12px; font-size: .82rem; font-weight: 600; color: var(--night); }
  @media (min-width: 861px) { .who__kabaka { position: sticky; top: 100px; } }
  @media (max-width: 860px) { .who__kabaka img { max-height: 380px; } }
  .who__divs { list-style: none; padding: 0; margin: 26px 0 24px; display: grid; gap: 4px; }
  .who__divs a { display: grid; grid-template-columns: 44px 1fr; gap: 14px; padding: 14px 12px; border-radius: var(--radius-m); text-decoration: none; color: var(--ink); }
  .who__divs a:hover { background: var(--mist); }
  .who__divs strong { display: block; color: var(--night); font-size: 1.04rem; }
  .who__divs span span { color: var(--muted); font-size: .95rem; }
  .who__icon { width: 44px; height: 44px; border-radius: 50%; background: var(--mist); color: var(--lion); display: grid; place-items: center; }

  .head-row { display: flex; flex-wrap: wrap; gap: 18px 32px; align-items: flex-end; justify-content: space-between; margin-bottom: 28px; }
  .head-row .lead { margin: 0; }
  .sector-links { list-style: none; padding: 0; margin: 0 0 28px; display: flex; flex-wrap: wrap; gap: 8px; }
  .sector-links a { display: inline-flex; gap: 8px; align-items: center; padding: 8px 14px; border: 1.5px solid var(--line); border-radius: 999px; background: #fff; text-decoration: none; color: var(--night); font-weight: 600; font-size: .92rem; }
  .sector-links a:hover { border-color: var(--lion); color: var(--lion); }
  .sector-links span { font-size: .78rem; background: var(--mist); color: var(--lion); border-radius: 999px; padding: 2px 7px; }

  .triple .lead { color: #c9d0ea; }
  .triple__list { list-style: none; padding: 0; margin: 36px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .triple__list li { padding: 26px 28px 8px 0; border-top: 2px solid var(--gold); margin-right: 28px; color: #c9d0ea; }
  .triple__list :global(svg) { color: var(--gold); margin-bottom: 16px; }
  .triple__list h3 { font-size: 1.4rem; }
  @media (max-width: 860px) { .triple__list { grid-template-columns: 1fr; } .triple__list li { margin-right: 0; } }

  .arms { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
  .arms a { height: 104px; display: grid; place-items: center; padding: 14px; border: 1px solid var(--line); border-radius: var(--radius-m); background: #fff; text-align: center; font-weight: 600; font-size: .9rem; color: var(--night); text-decoration: none; }
  .arms a:hover { border-color: var(--lion); box-shadow: var(--shadow); }
  .arms img { max-height: 70px; width: auto; object-fit: contain; }

  .partner-wall { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; }
  .partner-wall li { height: 92px; display: grid; place-items: center; padding: 12px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-s); }
  .partner-wall img { max-height: 60px; width: auto; object-fit: contain; filter: grayscale(1); opacity: .8; transition: filter .2s, opacity .2s; }
  .partner-wall li:hover img { filter: none; opacity: 1; }

  .cta { background: var(--lion); color: #e3e7f6; padding-block: clamp(48px, 7vw, 80px); }
  .cta__inner { display: flex; flex-wrap: wrap; gap: 24px 48px; align-items: center; justify-content: space-between; }
  .cta h2 { color: #fff; max-width: 20ch; }
  .cta p { max-width: 60ch; margin: 0; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
