---
// Floating WhatsApp button (bottom left). Number: +256 761 440 460
const { lang = "en" } = Astro.props;
const label = lang === "lg" ? "Tuwandiikire ku WhatsApp" : "Chat on WhatsApp";
const msg = lang === "lg" ? "Nkulamusizza BICUL, njagala okumanya ebisingawo." : "Hello BICUL, I would like to know more.";
const url = `https://wa.me/256761440460?text=${encodeURIComponent(msg)}`;
---
<a class="wa" href={url} target="_blank" rel="noopener" aria-label={`${label} (+256 761 440 460)`}>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2a8.2 8.2 0 01-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.7 11.9 11.9 0 004.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 001.9-1.3 2.3 2.3 0 00.2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
  <span>{label}</span>
</a>
<style>
  .wa { position: fixed; left: clamp(14px, 3vw, 28px); bottom: clamp(14px, 3vw, 28px); z-index: 60; display: flex; align-items: center; gap: 10px;
    height: 62px; padding: 0 22px 0 18px; border-radius: 999px; background: #25d366; color: #fff; text-decoration: none; font: 700 .98rem var(--body);
    box-shadow: 0 10px 30px -8px rgba(18,140,74,.6), 0 0 0 4px rgba(255,255,255,.9); animation: wa-bounce 4.5s ease-in-out 2.2s infinite; }
  .wa:hover { background: #128c4a; color: #fff; animation-play-state: paused; }
  @keyframes wa-bounce { 0%, 70%, 100% { transform: translateY(0); } 76% { transform: translateY(-14px); } 82% { transform: translateY(0); } 87% { transform: translateY(-6px); } 92% { transform: translateY(0); } }
  @media (max-width: 560px) { .wa { width: 60px; height: 60px; padding: 0; justify-content: center; } .wa span { display: none; } }
  @media (prefers-reduced-motion: reduce) { .wa { animation: none; } }
</style>
